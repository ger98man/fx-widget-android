<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything scales with the widget: height is split by weights
  (rows 5 : rate 0.7 : keys 3×1.4 : quick amounts 1.3) and every text auto-sizes
  to fill its cell, so a bigger widget means bigger numbers, not more empty space.
-->
<!-- Root is @android:id/background so launchers clip it to rounded corners; art sits under the content -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_base_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/theme_base_art" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Two currency rows with the swap button sitting on the seam between them -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout android:id="@+id/from_row" style="@style/FxRow"
                android:background="@drawable/row_active">
                <LinearLayout style="@style/FxRowLabel">
                    <TextView android:id="@+id/from_flag" style="@style/FxFlag" />
                    <TextView android:id="@+id/from_btn" style="@style/FxCode" />
                </LinearLayout>
                <TextView android:id="@+id/amount" style="@style/FxAmount"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/to_row" style="@style/FxRow"
                android:layout_marginTop="4dp"
                android:background="@drawable/row_plain">
                <LinearLayout style="@style/FxRowLabel">
                    <TextView android:id="@+id/to_flag" style="@style/FxFlag" />
                    <TextView android:id="@+id/to_btn" style="@style/FxCode" />
                </LinearLayout>
                <TextView android:id="@+id/result" style="@style/FxAmount"
                    android:textColor="#FF4FC3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Swap capsule right of the flags (row padding 10 + label 64 + 6): a ViewFlipper so the icon spins (swap_in/out) every time the sides flip -->
        <ViewFlipper
            android:id="@+id/swap_btn"
            android:layout_width="46dp"
            android:layout_height="80dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="80dp"
            android:background="@drawable/swap_pill"
            android:inAnimation="@anim/swap_in"
            android:outAnimation="@anim/swap_out">
            <ImageView android:id="@+id/swap_a" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="swap" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="18dp" android:paddingBottom="18dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_swap_tall" />
            <ImageView android:id="@+id/swap_b" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="swap" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="18dp" android:paddingBottom="18dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_swap_tall" />
        </ViewFlipper>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <TextView android:id="@+id/status" style="@style/FxStatus" />
        <ImageView android:id="@+id/refresh_btn" android:layout_width="36dp" android:layout_height="match_parent"
            android:contentDescription="refresh" android:padding="6dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout style="@style/FxKeyRow">
        <TextView android:id="@+id/k7" style="@style/FxKey" android:text="7" />
        <TextView android:id="@+id/k8" style="@style/FxKey" android:text="8" />
        <TextView android:id="@+id/k9" style="@style/FxKey" android:text="9" />
        <ImageView android:id="@+id/kback" style="@style/FxKeyIcon"
            android:contentDescription="backspace" android:src="@drawable/ic_backspace" />
    </LinearLayout>
    <LinearLayout style="@style/FxKeyRow">
        <TextView android:id="@+id/k4" style="@style/FxKey" android:text="4" />
        <TextView android:id="@+id/k5" style="@style/FxKey" android:text="5" />
        <TextView android:id="@+id/k6" style="@style/FxKey" android:text="6" />
        <TextView android:id="@+id/k0" style="@style/FxKey" android:text="0" />
    </LinearLayout>
    <LinearLayout style="@style/FxKeyRow">
        <TextView android:id="@+id/k1" style="@style/FxKey" android:text="1" />
        <TextView android:id="@+id/k2" style="@style/FxKey" android:text="2" />
        <TextView android:id="@+id/k3" style="@style/FxKey" android:text="3" />
        <TextView android:id="@+id/kdot" style="@style/FxKey" android:text="." android:textColor="#8B93A7" />
    </LinearLayout>

    <!-- Quick amounts: tap adds to the sum, C clears -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/q0" style="@style/FxQuick" />
        <TextView android:id="@+id/q1" style="@style/FxQuick" />
        <TextView android:id="@+id/q2" style="@style/FxQuick" />
        <TextView android:id="@+id/q3" style="@style/FxQuick" />
        <TextView android:id="@+id/q4" style="@style/FxQuick" />
        <TextView android:id="@+id/q5" style="@style/FxQuick" />
        <TextView android:id="@+id/kclr" style="@style/FxQuick" android:text="C" android:textColor="#FF4FC3" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
