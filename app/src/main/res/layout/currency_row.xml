<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView android:id="@+id/row_flag" android:layout_width="40dp" android:layout_height="wrap_content"
        android:textSize="26sp" />
    <TextView android:id="@+id/row_code" android:layout_width="52dp" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
        android:textColor="#AEB5C6" android:textSize="14sp" />
    <TextView android:id="@+id/row_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✓" android:textColor="#FF4FC3" android:textSize="20sp" android:textStyle="bold" />
</LinearLayout>
