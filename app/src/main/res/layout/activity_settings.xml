<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15181F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/settings_back" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:text="←" android:textColor="#FFFFFF" android:textSize="22sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Настройки" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:paddingStart="8dp"
        android:text="Валюты в списке выбора" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="8dp" android:paddingTop="2dp"
        android:text="Отмеченные валюты появятся, когда нажмёшь на валюту в виджете или в приложении"
        android:textColor="#8B93A7" android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">
        <TextView android:id="@+id/settings_counter" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#AEB5C6" android:textSize="13sp" />
        <TextView android:id="@+id/settings_all" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:background="@drawable/chip" android:gravity="center" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:text="Все" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/settings_none" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:background="@drawable/chip" android:gravity="center"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Только выбранные"
            android:textColor="#FF4FC3" android:textSize="14sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="4dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
