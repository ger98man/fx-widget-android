<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15181F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/update_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" android:background="@drawable/update_bg" android:padding="14dp"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/from_btn" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:gravity="center" android:background="@drawable/row_active"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/swap_btn" android:layout_width="56dp" android:layout_height="48dp"
            android:gravity="center" android:textColor="#FF4FC3" android:textSize="24sp" android:text="⇄" />
        <TextView android:id="@+id/to_btn" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:gravity="center" android:background="@drawable/row_active"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>

    <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="end" android:inputType="numberDecimal"
        android:backgroundTint="#FF4FC3" android:textColor="#FFFFFF" android:textColorHint="#5C6578"
        android:textSize="40sp" android:importantForAutofill="no" />

    <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="end" android:singleLine="true"
        android:textColor="#FF4FC3" android:textSize="40sp" android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/a0" style="@style/FxChip" />
        <TextView android:id="@+id/a1" style="@style/FxChip" />
        <TextView android:id="@+id/a2" style="@style/FxChip" />
        <TextView android:id="@+id/a3" style="@style/FxChip" />
        <TextView android:id="@+id/a4" style="@style/FxChip" />
        <TextView android:id="@+id/a5" style="@style/FxChip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#9AA3B5" android:textSize="13sp" />
        <TextView android:id="@+id/refresh_btn" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:textColor="#9AA3B5" android:textSize="22sp" android:text="⟳" />
    </LinearLayout>

    <!-- Rate source: bank (live) or fixed exchange-office rate for this pair -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/mode_bank" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="🏦  Банк"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/mode_fix" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center"
            android:text="💱  Фикс (обменник)" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fixed_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/row_active"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">
        <TextView android:id="@+id/fixed_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <EditText android:id="@+id/fixed_input" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:background="@null"
            android:gravity="end|center_vertical" android:hint="курс обменника" android:importantForAutofill="no"
            android:inputType="numberDecimal" android:textColor="#FF4FC3" android:textColorHint="#5C6578"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/fixed_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/fixed_clear" android:layout_width="40dp" android:layout_height="match_parent"
            android:gravity="center" android:text="✕" android:textColor="#8B93A7" android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/settings_btn" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:background="@drawable/chip" android:gravity="center" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:text="⚙  Настройки" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/version" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end" android:textColor="#5C6578" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
